{
  "name": "lifeboard",
  "private": true,
  "license": "MIT",
  "description": "Personal life dashboard. TypeScript in src/ bundled by esbuild to dist/; Scripts wrap the checks in tools/.",
  "scripts": {
    "bootstrap": "corepack enable && pnpm install && pnpm exec playwright install chromium",
    "dev": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/dev.ts",
    "build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && pnpm lint:boundaries",
    "lint:boundaries": "depcruise src",
    "test": "vitest run && pnpm -s spec-check && pnpm -s sim 20 8 > /dev/null",
    "spec-check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/spec-check.ts",
    "sim": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/sim.ts",
    "live-diff": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/live-diff.ts",
    "board": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/board.ts",
    "verify": "tools/verify.sh",
    "test:ui": "pnpm -s build && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/e2e/ui-smoke.ts",
    "check:no-js": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/check-no-js.ts",
    "check:public-board": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/check-public-board.ts",
    "lint:py": "tools/lint-python.sh",
    "eval": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON evals/run.ts"
  },
  "packageManager": "pnpm@12.21.0",
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@types/three": "0.170.0",
    "dependency-cruiser": "18.8.0",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "playwright": "^1.65.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
