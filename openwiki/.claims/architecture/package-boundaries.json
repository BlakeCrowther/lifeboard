      "id": "claim_8cce63b458c84b27a3902eadc5d1f4e6",
      "statement": "Each package under src/packages exposes only its root files as entry points; code outside the package, including other packages, may not import anything inside its subfolders, while a package's own files import each other freely.",
      "evidence": [
        {
          "resource": "repo://.dependency-cruiser.cjs#L1-L55",
          "version": "repo-lines-v1:sha256:fde5ea34b76a0234679e2d0ae1b2e20dbe864e068fde252ce67c5ae139b12c11:"
        }
      ]
    },
    {
      "id": "claim_1dc0825b925b40aa80e94fcfad3b147c",
      "statement": "Tests may import any package's entry points and their own tests/ fixtures but never any package's lib/ or other subfolder, not even their own, and only tests may import a tests/ folder.",
